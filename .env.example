# Copy to .env and fill in. Run with: node --env-file=.env server.js

# Required. Get a key at https://anakin.io/dashboard (500 free credits, no card required).
ANAKIN_API_KEY=

# Optional — defaults to the production API if unset.
ANAKIN_BASE_URL=https://api.anakin.io/v1

# Optional but strongly recommended in production. Developer Hub > Configure >
# Authentication > Client Secret. Without it, X-Body-Signature verification is
# skipped and any caller can POST fake canvas requests to this server.
INTERCOM_CLIENT_SECRET=

# Optional.
PORT=3000
